generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String
  name           String
  role           Role
  skills         String[]
  bio            String?
  avatarUrl      String?
  balance        Float          @default(0)
  location       String?
  website        String?
  // Data Rekening Bank (hanya terlihat oleh Freelancer itu sendiri & Admin)
  bankName       String?
  accountNumber  String?
  accountHolder  String?
  apps           Application[]
  conversations1 Conversation[] @relation("ConversationUser1")
  conversations2 Conversation[] @relation("ConversationUser2")
  jobs           Job[]          @relation("CompanyJobs")
  messages       Message[]
  transactions   Transaction[]
  ads            Advertisement[]
}

model Job {
  id          String        @id @default(uuid())
  slug        String        @unique @default(uuid())
  title       String
  description String
  budget      Float
  status      String        @default("OPEN")
  isPaidAd    Boolean       @default(false)
  expiresAt   DateTime?
  adFeePaid   Float         @default(0)
  companyId   String
  apps        Application[]
  company     User          @relation("CompanyJobs", fields: [companyId], references: [id])
}

// Status: PENDING | INTERVIEW | ACCEPTED | REJECTED
model Application {
  id           String  @id @default(uuid())
  jobId        String
  freelancerId String
  status       String  @default("PENDING")
  proposal     String?
  resumeUrl    String? // URL file di Supabase Storage (ZIP/PDF portofolio)
  freelancer   User    @relation(fields: [freelancerId], references: [id])
  job          Job     @relation(fields: [jobId], references: [id])
}

model Conversation {
  id        String    @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user1     User      @relation("ConversationUser1", fields: [user1Id], references: [id])
  user2     User      @relation("ConversationUser2", fields: [user2Id], references: [id])
  messages  Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
}

enum Role {
  FREELANCER
  COMPANY
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "DEPOSIT_ESCROW", "PAYOUT", "BUY_AD"
  amount      Float
  description String
  status      String   @default("SUCCESS")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Advertisement {
  id          String   @id @default(uuid())
  companyId   String
  imageUrl    String
  linkUrl     String?
  status      String   @default("ACTIVE") // "ACTIVE", "EXPIRED"
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  company     User     @relation(fields: [companyId], references: [id])
}
